---
import { formatTimeForEdmonton } from "../lib/helpers";
import Card from "./Card/index.astro";
---

<script>
  import { formatTimeForEdmonton } from "../lib/helpers";

  function updateClock() {
    const timeDisplay = document.getElementById("timeDisplay");
    const now = new Date();

    if (timeDisplay) {
      timeDisplay.textContent = formatTimeForEdmonton(now);
      timeDisplay.setAttribute("datetime", now.toISOString());
    }
  }

  updateClock();
  const interval = setInterval(updateClock, 1000);
  document.addEventListener("astro:before-swap", () => clearInterval(interval), { once: true });
</script>

<Card colSpan="lg:col-span-2" rowSpan="md:row-span-2" title="Time zone">
  <time
    datetime=""
    id="timeDisplay"
    class="text-2xl xl:text-5xl xl:whitespace-nowrap w-50 xl:w-100 h-[calc(100%-28px)] font-serif flex justify-center items-center"
  >
  </time>
</Card>
