---
import Layout from "../layouts/Layout.astro";
---

<script>
  import { animate } from "motion";
  import { loaderAnimation } from "../lib/constants";
  animate([loaderAnimation] as any);
</script>

<Layout
  title="Pickleball — Greg Knoblauch"
  description="Pickleball standings and a game log, ranked by Elo or DUPR."
>
  <!-- main is the scroll container (body is fixed-height + centered). -->
  <main class="w-screen h-screen overflow-y-auto text-white">
    <div class="max-w-3xl mx-auto px-4 py-8 w-full">
      <a
        href="/"
        class="inline-block mb-6 text-sm text-neutral-400 hover:text-white bg-darkslate-500 border border-neutral-700 hover:border-neutral-500 rounded-lg px-4 py-2 transition-colors duration-100"
      >
        ← Back
      </a>

      <h1 class="text-4xl font-black mb-1">🏓 Pickleball</h1>
      <p class="text-neutral-400 mb-8">
        Pickleball standings — rank by Elo or DUPR.
      </p>

      <!-- Add a game -->
      <section class="bg-darkslate-500 rounded-lg p-6 border border-neutral-700 mb-6">
        <h2 class="text-xl font-bold mb-4">Add a game</h2>

        <!-- Format toggle -->
        <div class="grid grid-cols-2 gap-3 mb-5" id="format-toggle">
          <button
            type="button"
            data-format="doubles"
            class="format-btn bg-darkslate-700 border border-neutral-700 rounded-lg py-2 text-sm font-semibold transition-colors duration-100 hover:border-neutral-500"
          >Doubles</button>
          <button
            type="button"
            data-format="singles"
            class="format-btn bg-darkslate-700 border border-neutral-700 rounded-lg py-2 text-sm font-semibold transition-colors duration-100 hover:border-neutral-500"
          >Singles</button>
        </div>

        <form id="game-form" class="flex flex-col gap-5">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <!-- Team A -->
            <div class="border border-neutral-700 rounded-lg p-4">
              <p class="text-sm text-neutral-400 mb-2">Team A</p>
              <div class="name-slot mb-2" data-slot="a1">
                <select id="a1-sel" class="name-select w-full bg-darkslate-700 border border-neutral-700 focus:border-primary-500 focus:outline-none rounded-md px-3 py-2 text-white"></select>
                <input id="a1-new" type="text" placeholder="New player name" autocomplete="off" class="name-new hidden mt-2 w-full bg-darkslate-700 border border-neutral-700 focus:border-primary-500 focus:outline-none rounded-md px-3 py-2 text-white" />
              </div>
              <div class="name-slot partner-slot mb-3" data-slot="a2">
                <select id="a2-sel" class="name-select w-full bg-darkslate-700 border border-neutral-700 focus:border-primary-500 focus:outline-none rounded-md px-3 py-2 text-white"></select>
                <input id="a2-new" type="text" placeholder="New partner name" autocomplete="off" class="name-new hidden mt-2 w-full bg-darkslate-700 border border-neutral-700 focus:border-primary-500 focus:outline-none rounded-md px-3 py-2 text-white" />
              </div>
              <label class="block text-xs text-neutral-500 mb-1" for="score-a">Score</label>
              <input
                id="score-a" type="number" min="0" step="1" inputmode="numeric"
                class="w-24 bg-darkslate-700 border border-neutral-700 focus:border-primary-500 focus:outline-none rounded-md px-3 py-2 text-white text-lg tabular-nums"
              />
            </div>

            <!-- Team B -->
            <div class="border border-neutral-700 rounded-lg p-4">
              <p class="text-sm text-neutral-400 mb-2">Team B</p>
              <div class="name-slot mb-2" data-slot="b1">
                <select id="b1-sel" class="name-select w-full bg-darkslate-700 border border-neutral-700 focus:border-primary-500 focus:outline-none rounded-md px-3 py-2 text-white"></select>
                <input id="b1-new" type="text" placeholder="New player name" autocomplete="off" class="name-new hidden mt-2 w-full bg-darkslate-700 border border-neutral-700 focus:border-primary-500 focus:outline-none rounded-md px-3 py-2 text-white" />
              </div>
              <div class="name-slot partner-slot mb-3" data-slot="b2">
                <select id="b2-sel" class="name-select w-full bg-darkslate-700 border border-neutral-700 focus:border-primary-500 focus:outline-none rounded-md px-3 py-2 text-white"></select>
                <input id="b2-new" type="text" placeholder="New partner name" autocomplete="off" class="name-new hidden mt-2 w-full bg-darkslate-700 border border-neutral-700 focus:border-primary-500 focus:outline-none rounded-md px-3 py-2 text-white" />
              </div>
              <label class="block text-xs text-neutral-500 mb-1" for="score-b">Score</label>
              <input
                id="score-b" type="number" min="0" step="1" inputmode="numeric"
                class="w-24 bg-darkslate-700 border border-neutral-700 focus:border-primary-500 focus:outline-none rounded-md px-3 py-2 text-white text-lg tabular-nums"
              />
            </div>
          </div>

          <div class="flex flex-wrap gap-4 items-end">
            <div>
              <label class="block text-xs text-neutral-500 mb-1" for="played-on">Date</label>
              <input
                id="played-on" type="date"
                class="bg-darkslate-700 border border-neutral-700 focus:border-primary-500 focus:outline-none rounded-md px-3 py-2 text-white"
              />
            </div>
            <div>
              <label class="block text-xs text-neutral-500 mb-1" for="passcode">Passcode</label>
              <input
                id="passcode" type="password" autocomplete="off" placeholder="to record"
                class="w-32 bg-darkslate-700 border border-neutral-700 focus:border-primary-500 focus:outline-none rounded-md px-3 py-2 text-white"
              />
            </div>
            <button
              id="submit-btn" type="submit"
              class="ml-auto bg-primary-500 hover:bg-primary-600 text-white font-semibold rounded-lg px-5 py-2 transition-colors duration-100 disabled:opacity-50 disabled:cursor-not-allowed"
            >Add game</button>
          </div>

          <p id="form-msg" class="text-sm hidden"></p>
        </form>
      </section>

      <!-- Standings -->
      <section class="bg-darkslate-500 rounded-lg p-6 border border-neutral-700 mb-6">
        <div class="flex items-center justify-between gap-3 flex-wrap mb-4">
          <h2 class="text-xl font-bold">Standings</h2>
          <!-- Rank-by toggle -->
          <div class="inline-flex rounded-lg border border-neutral-700 overflow-hidden text-xs" id="rank-toggle">
            <button type="button" data-metric="elo" class="rank-btn px-3 py-1.5 font-semibold text-neutral-400 hover:text-white transition-colors duration-100">Elo</button>
            <button type="button" data-metric="dupr" class="rank-btn px-3 py-1.5 font-semibold text-neutral-400 hover:text-white transition-colors duration-100 border-l border-neutral-700">DUPR</button>
          </div>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="text-neutral-400 text-left border-b border-neutral-700">
                <th class="py-2 pr-2 font-medium">#</th>
                <th class="py-2 pr-2 font-medium">Player</th>
                <th id="rating-header" class="py-2 pr-2 font-medium text-right">Elo</th>
                <th class="py-2 pr-2 font-medium text-right">W–L</th>
                <th class="py-2 pr-2 font-medium text-right">Games</th>
                <th class="py-2 font-medium text-right">Win%</th>
              </tr>
            </thead>
            <tbody id="standings-body"></tbody>
          </table>
        </div>
        <p id="standings-empty" class="text-neutral-500 text-sm hidden">
          No games yet — add one above to get started.
        </p>
        <p id="standings-loading" class="text-neutral-500 text-sm">Loading…</p>
        <p class="text-neutral-600 text-xs mt-3">
          DUPR here is a club-style rating (DUPR's 2.0–8.0 scale with
          margin-of-victory), not an official DUPR number.
        </p>
      </section>

      <!-- Game log -->
      <section class="bg-darkslate-500 rounded-lg p-6 border border-neutral-700">
        <div class="flex items-center justify-between gap-3 flex-wrap mb-4">
          <h2 class="text-xl font-bold">Game log</h2>
          <div class="flex gap-2">
            <select id="log-player" class="log-filter bg-darkslate-700 border border-neutral-700 focus:border-primary-500 focus:outline-none rounded-md pl-2 py-1 text-xs text-neutral-300"></select>
            <select id="log-format" class="log-filter bg-darkslate-700 border border-neutral-700 focus:border-primary-500 focus:outline-none rounded-md pl-2 py-1 text-xs text-neutral-300">
              <option value="all">All formats</option>
              <option value="doubles">Doubles</option>
              <option value="singles">Singles</option>
            </select>
          </div>
        </div>
        <ul id="log-body" class="flex flex-col gap-2"></ul>
        <p id="log-empty" class="text-neutral-500 text-sm hidden">No games logged yet.</p>
        <p id="log-none" class="text-neutral-500 text-sm hidden">No games match these filters.</p>
      </section>
    </div>
  </main>
</Layout>

<style>
  /* Hide native number spinners so the score fields match the dark theme. */
  input[type="number"]::-webkit-inner-spin-button,
  input[type="number"]::-webkit-outer-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }
  input[type="number"] {
    -moz-appearance: textfield;
    appearance: textfield;
  }

  /* Themed dropdown chevron so <select> matches the inputs. */
  select.name-select,
  select.log-filter {
    -webkit-appearance: none;
    -moz-appearance: none;
    appearance: none;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='%23a3a3a3' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M6 9l6 6 6-6'/></svg>");
    background-repeat: no-repeat;
    background-position: right 0.7rem center;
    background-size: 1rem;
    padding-right: 2.2rem;
  }
  select.name-select option,
  select.log-filter option {
    color: #fff;
    background: #1f2430;
  }
  /* Dim the "Select player…" prompt so it reads as a placeholder, not a value. */
  select.name-select.is-placeholder {
    color: #737373;
  }
</style>

<script>
  import { supabase, SUPABASE_URL } from "../lib/supabase";
  import {
    computeStandings,
    allPlayerNames,
    sortGamesChronologically,
    type Game,
  } from "../lib/pickleball";

  const PASSCODE_KEY = "pickleball-passcode";
  const NEW_VALUE = "__new__";
  const SLOTS = ["a1", "a2", "b1", "b2"] as const;
  type Slot = (typeof SLOTS)[number];

  // --- Elements ---
  const standingsBody = document.getElementById("standings-body")!;
  const standingsEmpty = document.getElementById("standings-empty")!;
  const standingsLoading = document.getElementById("standings-loading")!;
  const logBody = document.getElementById("log-body")!;
  const logEmpty = document.getElementById("log-empty")!;
  const logNone = document.getElementById("log-none")!;
  const logPlayerSel = document.getElementById("log-player") as HTMLSelectElement;
  const logFormatSel = document.getElementById("log-format") as HTMLSelectElement;
  const rankBtns = Array.from(
    document.querySelectorAll<HTMLButtonElement>(".rank-btn"),
  );
  const ratingHeader = document.getElementById("rating-header")!;

  const form = document.getElementById("game-form") as HTMLFormElement;
  const formBtns = Array.from(
    document.querySelectorAll<HTMLButtonElement>(".format-btn"),
  );
  const partnerSlots = Array.from(
    document.querySelectorAll<HTMLElement>(".partner-slot"),
  );
  const scoreA = document.getElementById("score-a") as HTMLInputElement;
  const scoreB = document.getElementById("score-b") as HTMLInputElement;
  const playedOn = document.getElementById("played-on") as HTMLInputElement;
  const passcode = document.getElementById("passcode") as HTMLInputElement;
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;
  const formMsg = document.getElementById("form-msg")!;

  const sel = (s: Slot) => document.getElementById(`${s}-sel`) as HTMLSelectElement;
  const newInput = (s: Slot) => document.getElementById(`${s}-new`) as HTMLInputElement;

  let format: "doubles" | "singles" = "doubles";
  let knownNames: string[] = [];
  let metric: "elo" | "dupr" = "elo";
  let currentGames: Game[] = [];

  // --- Defaults ---
  playedOn.value = new Date().toISOString().slice(0, 10);
  try {
    const saved = localStorage.getItem(PASSCODE_KEY);
    if (saved) passcode.value = saved;
  } catch {}

  function escapeHtml(s: string): string {
    return s.replace(/[&<>"']/g, (c) =>
      ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]!,
    );
  }

  // --- Player dropdowns ---
  function optionsHtml(names: string[]): string {
    return (
      `<option value="" disabled selected>Select player…</option>` +
      names
        .map((n) => `<option value="${escapeHtml(n)}">${escapeHtml(n)}</option>`)
        .join("") +
      `<option value="${NEW_VALUE}">➕ New player…</option>`
    );
  }

  function updatePlaceholderClass(el: HTMLSelectElement) {
    el.classList.toggle("is-placeholder", el.value === "");
  }

  function populateSelects(names: string[]) {
    for (const s of SLOTS) {
      const el = sel(s);
      const prev = el.value;
      el.innerHTML = optionsHtml(names);
      // Keep the current choice if it's still valid, else fall back to the prompt.
      if (prev === NEW_VALUE || names.includes(prev)) el.value = prev;
      else el.selectedIndex = 0;
      updatePlaceholderClass(el);
    }
  }

  function clearInvalid() {
    for (const s of SLOTS) {
      sel(s).classList.remove("!border-primary-500");
      newInput(s).classList.remove("!border-primary-500");
    }
  }

  function markInvalid(s: Slot) {
    const control = sel(s).value === NEW_VALUE ? newInput(s) : sel(s);
    control.classList.add("!border-primary-500");
  }

  function toggleNewInput(s: Slot) {
    const isNew = sel(s).value === NEW_VALUE;
    const input = newInput(s);
    input.classList.toggle("hidden", !isNew);
    if (isNew) input.focus();
    else input.value = "";
  }

  function readName(s: Slot): string {
    const el = sel(s);
    return el.value === NEW_VALUE ? newInput(s).value.trim() : el.value;
  }

  function resetSlots() {
    for (const s of SLOTS) {
      sel(s).selectedIndex = 0;
      updatePlaceholderClass(sel(s));
      const input = newInput(s);
      input.value = "";
      input.classList.add("hidden");
    }
    clearInvalid();
  }

  for (const s of SLOTS) {
    sel(s).addEventListener("change", () => {
      toggleNewInput(s);
      updatePlaceholderClass(sel(s));
      clearInvalid();
      clearMsg();
    });
  }

  // --- Format toggle ---
  function renderFormat() {
    formBtns.forEach((btn) => {
      const active = btn.dataset.format === format;
      btn.classList.toggle("!bg-primary-500", active);
      btn.classList.toggle("!border-primary-500", active);
      btn.classList.toggle("text-white", active);
    });
    const doubles = format === "doubles";
    partnerSlots.forEach((el) => el.classList.toggle("hidden", !doubles));
    if (!doubles) {
      for (const s of ["a2", "b2"] as Slot[]) {
        sel(s).selectedIndex = 0;
        updatePlaceholderClass(sel(s));
        newInput(s).value = "";
        newInput(s).classList.add("hidden");
      }
    }
  }
  formBtns.forEach((btn) =>
    btn.addEventListener("click", () => {
      format = btn.dataset.format as "doubles" | "singles";
      renderFormat();
    }),
  );
  renderFormat();

  // --- Rendering ---
  function setMsg(text: string, kind: "error" | "ok") {
    formMsg.textContent = text;
    formMsg.classList.remove("hidden", "text-primary-500", "text-green-400");
    formMsg.classList.add(kind === "error" ? "text-primary-500" : "text-green-400");
  }
  function clearMsg() {
    formMsg.classList.add("hidden");
    formMsg.textContent = "";
  }

  // --- Rank-by (Elo / DUPR) toggle ---
  function renderRankToggle() {
    rankBtns.forEach((btn) => {
      const active = btn.dataset.metric === metric;
      btn.classList.toggle("bg-primary-500", active);
      btn.classList.toggle("text-white", active);
      btn.classList.toggle("text-neutral-400", !active);
    });
    ratingHeader.textContent = metric === "dupr" ? "DUPR" : "Elo";
  }
  rankBtns.forEach((btn) =>
    btn.addEventListener("click", () => {
      metric = btn.dataset.metric as "elo" | "dupr";
      renderRankToggle();
      renderStandings();
    }),
  );
  renderRankToggle();

  function renderStandings() {
    const standings = computeStandings(currentGames, metric);
    standingsLoading.classList.add("hidden");
    if (standings.length === 0) {
      standingsBody.innerHTML = "";
      standingsEmpty.classList.remove("hidden");
      return;
    }
    standingsEmpty.classList.add("hidden");
    standingsBody.innerHTML = standings
      .map((s, i) => {
        const value = metric === "dupr" ? s.dupr.toFixed(2) : String(s.elo);
        return `
          <tr class="border-b border-neutral-800 last:border-0">
            <td class="py-2 pr-2 text-neutral-500 tabular-nums">${i + 1}</td>
            <td class="py-2 pr-2 font-medium">${escapeHtml(s.name)}</td>
            <td class="py-2 pr-2 text-right font-bold text-primary-500 tabular-nums">${value}</td>
            <td class="py-2 pr-2 text-right tabular-nums">${s.wins}–${s.losses}</td>
            <td class="py-2 pr-2 text-right text-neutral-400 tabular-nums">${s.games}</td>
            <td class="py-2 text-right text-neutral-400 tabular-nums">${s.winPct}%</td>
          </tr>`;
      })
      .join("");
  }

  // --- Game-log filters ---
  function populateLogPlayerFilter(names: string[]) {
    const prev = logPlayerSel.value;
    logPlayerSel.innerHTML =
      `<option value="">All players</option>` +
      names
        .map((n) => `<option value="${escapeHtml(n)}">${escapeHtml(n)}</option>`)
        .join("");
    if (names.includes(prev)) logPlayerSel.value = prev;
  }

  function renderLog() {
    const player = logPlayerSel.value; // "" = all
    const fmt = logFormatSel.value; // "all" | "doubles" | "singles"

    let log = sortGamesChronologically(currentGames).reverse();
    if (player) {
      log = log.filter(
        (g) => g.team_a.includes(player) || g.team_b.includes(player),
      );
    }
    if (fmt !== "all") log = log.filter((g) => g.format === fmt);

    const hasGames = currentGames.length > 0;
    logEmpty.classList.toggle("hidden", hasGames);
    logNone.classList.toggle("hidden", !(hasGames && log.length === 0));

    logBody.innerHTML = log
      .map((g) => {
        const aWon = g.score_a > g.score_b;
        const teamA = escapeHtml(g.team_a.join(" & "));
        const teamB = escapeHtml(g.team_b.join(" & "));
        const aCls = aWon ? "font-bold text-white" : "text-neutral-400";
        const bCls = !aWon ? "font-bold text-white" : "text-neutral-400";
        return `
          <li class="flex items-center justify-between gap-3 border border-neutral-800 rounded-md px-3 py-2 text-sm">
            <div class="min-w-0">
              <span class="${aCls}">${teamA}</span>
              <span class="text-neutral-600"> vs </span>
              <span class="${bCls}">${teamB}</span>
            </div>
            <div class="flex items-center gap-3 shrink-0">
              <span class="tabular-nums"><span class="${aWon ? "text-white font-bold" : "text-neutral-500"}">${g.score_a}</span><span class="text-neutral-600">–</span><span class="${!aWon ? "text-white font-bold" : "text-neutral-500"}">${g.score_b}</span></span>
              <span class="text-neutral-600 text-xs">${escapeHtml(g.played_on)}</span>
              <button type="button" class="del-btn text-neutral-600 hover:text-primary-500 transition-colors duration-100 px-1" data-id="${escapeHtml(g.id)}" title="Delete game" aria-label="Delete game">✕</button>
            </div>
          </li>`;
      })
      .join("");
  }

  logPlayerSel.addEventListener("change", renderLog);
  logFormatSel.addEventListener("change", renderLog);

  // Delete a game (passcode-gated; RLS blocks direct anon deletes).
  logBody.addEventListener("click", async (e) => {
    const btn = (e.target as HTMLElement).closest(".del-btn") as HTMLElement | null;
    if (!btn) return;
    const id = btn.dataset.id!;
    if (!confirm("Delete this game? Standings will recalculate.")) return;
    const pass =
      passcode.value || window.prompt("Passcode to delete this game?") || "";
    if (!pass) return;

    btn.textContent = "…";
    const { error } = await supabase.rpc("delete_game", {
      p_passcode: pass,
      p_id: id,
    });
    if (error) {
      alert(/passcode/i.test(error.message) ? "Wrong passcode." : `Error: ${error.message}`);
      btn.textContent = "✕";
      return;
    }
    try {
      localStorage.setItem(PASSCODE_KEY, pass);
    } catch {}
    await loadGames();
  });

  function render(games: Game[]) {
    currentGames = games;
    knownNames = allPlayerNames(games);
    populateSelects(knownNames);
    populateLogPlayerFilter(knownNames);
    renderStandings();
    renderLog();
  }

  // --- Data ---
  async function loadGames() {
    if (SUPABASE_URL.includes("YOUR_PROJECT")) {
      standingsLoading.textContent =
        "Standings will appear here once Supabase is connected.";
      return;
    }
    const { data, error } = await supabase
      .from("games")
      .select("id, played_on, created_at, format, team_a, team_b, score_a, score_b");
    if (error) {
      standingsLoading.textContent = `Couldn't load games: ${error.message}`;
      return;
    }
    render((data ?? []) as Game[]);
  }

  // --- Submit ---
  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    clearMsg();
    clearInvalid();

    const requiredSlots: Slot[] =
      format === "doubles" ? ["a1", "a2", "b1", "b2"] : ["a1", "b1"];
    const missing = requiredSlots.filter((s) => !readName(s));
    if (missing.length > 0) {
      missing.forEach(markInvalid);
      setMsg("Select a player for each highlighted spot.", "error");
      return;
    }

    const teamA = [readName("a1"), format === "doubles" ? readName("a2") : ""]
      .filter(Boolean);
    const teamB = [readName("b1"), format === "doubles" ? readName("b2") : ""]
      .filter(Boolean);
    const everyone = [...teamA, ...teamB].map((n) => n.toLowerCase());
    if (new Set(everyone).size !== everyone.length) {
      setMsg("Each player can only appear once.", "error");
      return;
    }
    const sa = Number(scoreA.value);
    const sb = Number(scoreB.value);
    if (!Number.isInteger(sa) || !Number.isInteger(sb) || sa < 0 || sb < 0) {
      setMsg("Scores must be whole numbers.", "error");
      return;
    }
    if (sa === sb) {
      setMsg("Scores can't be tied.", "error");
      return;
    }
    if (!passcode.value) {
      setMsg("Passcode required to record a game.", "error");
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = "Saving…";

    const { error } = await supabase.rpc("add_game", {
      p_passcode: passcode.value,
      p_played_on: playedOn.value,
      p_format: format,
      p_team_a: teamA,
      p_team_b: teamB,
      p_score_a: sa,
      p_score_b: sb,
    });

    submitBtn.disabled = false;
    submitBtn.textContent = "Add game";

    if (error) {
      const wrongPass = /passcode/i.test(error.message);
      setMsg(wrongPass ? "Wrong passcode." : `Error: ${error.message}`, "error");
      return;
    }

    try {
      localStorage.setItem(PASSCODE_KEY, passcode.value);
    } catch {}

    // Clear players/scores for the next entry; keep date & passcode.
    resetSlots();
    scoreA.value = scoreB.value = "";
    setMsg("Game added ✓", "ok");
    await loadGames();
  });

  loadGames();
</script>
